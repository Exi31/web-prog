@model IEnumerable<Learner>
@{
    ViewData["Title"] = "Danh sách người học";
    Layout = "~/Views/Shared/MyLayout.cshtml";
}
<h1>Danh sách người học</h1>
@await Component.InvokeAsync("Major")
<a asp-action="Create" class="btn btn-primary mb-3">Thêm người học</a>

<div id="learner-results"
     data-url="@Url.Action("LearnerFilter", "Learner")">
    <partial name="LearnerTable" model="Model" />
</div>

@section Scripts {
    <script>
        $(function () {
            const $results = $("#learner-results");

            function loadLearners(data) {
                $.ajax({
                    url: $results.attr("data-url"),
                    method: "GET",
                    data: data
                })
                .done(function (html) {
                    $results.html(html);
                })
                .fail(function () {
                    alert("Không tải được danh sách người học.");
                });
            }

            $(document).on("click", "a.js-learner-filter", function (event) {
                event.preventDefault();
                const query = new URL(this.href).search.slice(1);
                loadLearners(query);
            });

            $(document).on("submit", "#learner-search", function (event) {
                event.preventDefault();
                loadLearners($(this).serialize());
            });
        });
    </script>
}